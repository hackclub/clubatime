import { desc, eq, sql } from "drizzle-orm";
import { db } from "./db";
import { submission } from "./db/schema/projects";

export type Submission = typeof submission.$inferSelect;
export type NewSubmission = typeof submission.$inferInsert;

/**
 * Create a new submission.
 */
export async function createSubmission(
	data: Omit<NewSubmission, "id" | "createdAt" | "updatedAt">,
): Promise<Submission> {
	const [row] = await db.insert(submission).values(data).returning();
	return row;
}

/**
 * Get all submissions for a given user, newest first.
 */
export async function getSubmissionsByUser(
	userId: string,
): Promise<Submission[]> {
	return db
		.select()
		.from(submission)
		.where(eq(submission.userId, userId))
		.orderBy(desc(submission.createdAt));
}

/**
 * Get a single submission by ID.
 */
export async function getSubmissionById(
	id: string,
): Promise<Submission | undefined> {
	const [row] = await db
		.select()
		.from(submission)
		.where(eq(submission.id, id))
		.limit(1);
	return row;
}

/**
 * Get all submissions (for admin review), newest first.
 * Optionally filter by status.
 */
export async function getAllSubmissions(
	status?: string,
): Promise<Submission[]> {
	const query = db.select().from(submission);
	if (status) {
		return query
			.where(eq(submission.status, status))
			.orderBy(desc(submission.createdAt));
	}
	return query.orderBy(desc(submission.createdAt));
}

/**
 * Update submission status (for admin review).
 */
export async function reviewSubmission(
	id: string,
	reviewerId: string,
	data: {
		status: string;
		reviewerNotes?: string;
		hoursAwarded?: number;
	},
): Promise<Submission | undefined> {
	const [row] = await db
		.update(submission)
		.set({
			status: data.status,
			reviewerNotes: data.reviewerNotes ?? null,
			hoursAwarded: data.hoursAwarded ?? null,
			reviewedBy: reviewerId,
			reviewedAt: new Date(),
		})
		.where(eq(submission.id, id))
		.returning();
	return row;
}

/**
 * Get total approved hours for a user.
 */
export async function getApprovedHours(userId: string): Promise<number> {
	const [result] = await db
		.select({ total: sql<number>`coalesce(sum(${submission.hoursAwarded}), 0)` })
		.from(submission)
		.where(eq(submission.userId, userId));
	return Number(result?.total ?? 0);
}
