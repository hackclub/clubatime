import { error } from "@sveltejs/kit";
import { getRequestEvent, query } from "$app/server";
import { auth } from "./server/auth";
import { isLeader } from "./server/clubs-api";
import {
	getApprovedHours,
	getSubmissionsByUser,
} from "./server/submissions";

/**
 * Get club-leader-specific data.
 * Returns the current user's submissions + leader status.
 */
export const getClubData = query(async () => {
	const session = await auth.api.getSession({
		headers: getRequestEvent().request.headers,
	});

	if (!session?.user) return null;

	const leader = await isLeader(session.user.id);
	const submissions = await getSubmissionsByUser(session.user.id);
	const totalHours = await getApprovedHours(session.user.id);

	return { leader, submissions, totalHours, user: session.user };
});
