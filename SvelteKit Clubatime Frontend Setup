 * Only accessible to users with role "admin".
 */
export const getAdminData = query(async () => {
	const session = await auth.api.getSession({
		headers: getRequestEvent().request.headers,
	});

	if (!session?.user) return null;

	// @ts-expect-error -- additionalFields adds `role` at runtime
	if (session.user.role !== "admin") {
		error(403, "Admin access required");
	}

	const pending = await getAllSubmissions("pending");
	const all = await getAllSubmissions();

	return { pending, all };
});

/**
 * Review (approve / reject / request revision) a submission.
 */
export const reviewProject = form(async () => {
	const event = getRequestEvent();
	const session = await auth.api.getSession({
		headers: event.request.headers,
	});

	if (!session?.user) {
		error(401, "You must be signed in");
	}

	// @ts-expect-error -- additionalFields adds `role` at runtime
	if (session.user.role !== "admin") {
		error(403, "Admin access required");
	}

	const formData = await event.request.formData();

	const raw = {
		submissionId: formData.get("submissionId") as string,
		status: formData.get("status") as string,
		reviewerNotes: (formData.get("reviewerNotes") as string) || undefined,
		hoursAwarded: formData.get("hoursAwarded")
			? Number(formData.get("hoursAwarded"))
			: undefined,
	};

	const result = v.safeParse(ReviewSchema, raw);
	if (!result.success) {
		const messages = result.issues.map((i) => i.message).join("; ");
		error(400, messages);
	}

	await reviewSubmission(session.user.id, result.output.submissionId, {
		status: result.output.status,
		reviewerNotes: result.output.reviewerNotes,
		hoursAwarded: result.output.hoursAwarded,
	});
});
