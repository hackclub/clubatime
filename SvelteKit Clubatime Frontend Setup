import { eq, lt } from "drizzle-orm";
import { env } from "$env/dynamic/private";
import { db } from "./db";
import { clubsCache } from "./db/schema/projects";

const CLUBS_API_BASE = "https://clubapi.hackclub.com";
const CACHE_TTL_MS = 15 * 60 * 1000; // 15 minutes

interface ClubApiClub {
	id: string;
	name: string;
	description?: string;
	leaders: string[];
	members: { id: string; name: string; email?: string }[];
	[key: string]: unknown;
}

async function fetchFromApi(path: string): Promise<unknown> {
	const res = await fetch(`${CLUBS_API_BASE}${path}`, {
		headers: {
			Authorization: `Bearer ${env.CLUBS_API_KEY}`,
			"Content-Type": "application/json",
		},
	});

	if (!res.ok) {
		const text = await res.text();
		throw new Error(`Clubs API ${path} failed (${res.status}): ${text}`);
	}

	return res.json();
}

/**
 * Get a club by ID, using the Postgres cache when possible.
 */
export async function getClub(clubId: string): Promise<typeof clubsCache.$inferSelect | null> {
	// Check cache first
	const [cached] = await db
		.select()
		.from(clubsCache)
		.where(eq(clubsCache.id, clubId))
		.limit(1);

	if (cached && cached.expiresAt > new Date()) {
		return cached;
	}

	// Cache miss or expired — fetch from API
	try {
		const club = (await fetchFromApi(`/clubs/${clubId}`)) as ClubApiClub;
		const now = new Date();
		const expiresAt = new Date(now.getTime() + CACHE_TTL_MS);

		const record = {
			id: club.id,
			name: club.name,
			description: club.description ?? null,
			leaders: club.leaders ?? [],
			members: club.members ?? [],
			rawData: club,
			cachedAt: now,
			expiresAt,
		};

		await db
			.insert(clubsCache)
			.values(record)
			.onConflictDoUpdate({
				target: clubsCache.id,
				set: record,
			});

		return record as typeof clubsCache.$inferSelect;
	} catch (err) {
		// If API fails but we have stale cache, return it
		if (cached) return cached;
		throw err;
	}
}

/**
 * Check if a user ID is a leader of any cached club.
 */
export async function isLeader(userId: string): Promise<boolean> {
	const clubs = await db.select().from(clubsCache);
	return clubs.some((club) => (club.leaders as string[]).includes(userId));
}

/**
 * Prune expired cache entries.
 */
export async function pruneClubsCache(): Promise<void> {
	await db.delete(clubsCache).where(lt(clubsCache.expiresAt, new Date()));
}
