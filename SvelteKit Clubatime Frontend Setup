import { error, redirect } from "@sveltejs/kit";
import * as v from "valibot";
import { form, getRequestEvent, query } from "$app/server";
import { auth } from "./server/auth";
import { uploadFiles } from "./server/hc-cdn";
import {
	createSubmission,
	getApprovedHours,
	getSubmissionsByUser,
} from "./server/submissions";
import { SubmissionSchema } from "./schemas/submission";

/**
 * Return the current user's profile data for form prefill,
 * plus their existing submissions.
 */
export const getSubmitPageData = query(async () => {
	const session = await auth.api.getSession({
		headers: getRequestEvent().request.headers,
	});

	if (!session?.user) return null;

	const submissions = await getSubmissionsByUser(session.user.id);
	const totalHours = await getApprovedHours(session.user.id);

	return {
		user: {
			id: session.user.id,
			name: session.user.name,
			email: session.user.email,
		},
		submissions,
		totalHours,
	};
});

/**
 * Handle project submission.
 * Validates text fields with Valibot, uploads screenshots to HC CDN,
 * and inserts a row into the submissions table.
 */
export const submitProject = form(async () => {
	const event = getRequestEvent();
	const session = await auth.api.getSession({
		headers: event.request.headers,
	});

	if (!session?.user) {
		error(401, "You must be signed in to submit a project");
	}

	const formData = await event.request.formData();

	// Parse text fields
	const raw = {
		projectName: formData.get("projectName") as string,
		description: formData.get("description") as string,
		repoUrl: formData.get("repoUrl") as string,
		demoUrl: (formData.get("demoUrl") as string) || undefined,
		hoursRequested: Number(formData.get("hoursRequested")),
	};

	const result = v.safeParse(SubmissionSchema, raw);

	if (!result.success) {
		const messages = result.issues.map((i) => i.message).join("; ");
		error(400, messages);
	}

	// Handle file uploads
	const files = formData.getAll("screenshots") as File[];
	const validFiles = files.filter((f) => f.size > 0);

	let screenshotUrls: string[] = [];
	if (validFiles.length > 0) {
		screenshotUrls = await uploadFiles(validFiles);
	}

	// Insert into DB
	await createSubmission({
		userId: session.user.id,
		projectName: result.output.projectName,
		description: result.output.description,
		repoUrl: result.output.repoUrl,
		demoUrl: result.output.demoUrl ?? null,
		screenshotUrls,
		hoursRequested: result.output.hoursRequested,
		status: "pending",
	});

	redirect(303, "/hours?submitted=true");
});
