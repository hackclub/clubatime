import { env } from "$env/dynamic/private";

const HC_CDN_BASE = "https://cdn.hackclub.com";

/**
 * Convert a File to a data URL string.
 */
async function fileToDataUrl(file: File): Promise<string> {
	const buffer = await file.arrayBuffer();
	const base64 = Buffer.from(buffer).toString("base64");
	return `data:${file.type};base64,${base64}`;
}

/**
 * Upload a data URL to the Hack Club CDN.
 * Returns the permanent CDN URL on success.
 */
export async function uploadDataUrl(dataUrl: string): Promise<string> {
	const res = await fetch(`${HC_CDN_BASE}/api/upload`, {
		method: "POST",
		headers: {
			"Content-Type": "application/json",
			Authorization: `Bearer ${env.HC_CDN_API_KEY}`,
		},
		body: JSON.stringify({ data: dataUrl }),
	});

	if (!res.ok) {
		const text = await res.text();
		throw new Error(`HC CDN upload failed (${res.status}): ${text}`);
	}

	const json = await res.json();
	// The CDN returns the URL of the uploaded file.
	// Adjust the field name if the actual API response differs.
	return json.url as string;
}

/**
 * Upload a File object to the Hack Club CDN.
 * Converts to data URL first, then uploads.
 * Returns the permanent CDN URL.
 */
export async function uploadFile(file: File): Promise<string> {
	const dataUrl = await fileToDataUrl(file);
	return uploadDataUrl(dataUrl);
}

/**
 * Upload multiple files in parallel.
 * Returns an array of permanent CDN URLs.
 */
export async function uploadFiles(files: File[]): Promise<string[]> {
	return Promise.all(files.map(uploadFile));
}
