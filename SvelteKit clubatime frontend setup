import { env } from "$env/dynamic/private";
import * as v from "valibot";

const CLUBS_API_URL = "https://clubapi.hackclub.com";

// Response schemas
const LeaderCheckSchema = v.object({
  leader: v.union([v.boolean(), v.string()]), // true/false or club_name
});

const ClubMemberSchema = v.object({
  email: v.string(),
  name: v.optional(v.string()),
  role: v.optional(v.string()),
});

const ClubMembersSchema = v.array(ClubMemberSchema);

export type LeaderStatus = {
  isLeader: boolean;
  clubName: string | null;
};

/**
 * Check if a user is a club leader by email
 */
export async function getLeaderByEmail(email: string): Promise<LeaderStatus> {
  const res = await fetch(
    `${CLUBS_API_URL}/leader?email=${encodeURIComponent(email)}`,
    {
      headers: {
        Authorization: `Bearer ${env.CLUBS_API_KEY}`,
      },
    }
  );

  if (!res.ok) {
    console.error(`Clubs API error: ${res.status}`);
    return { isLeader: false, clubName: null };
  }

  const data = await res.json();
  const parsed = v.safeParse(LeaderCheckSchema, data);

  if (!parsed.success) {
    console.error("Invalid Clubs API response", parsed.issues);
    return { isLeader: false, clubName: null };
  }

  const { leader } = parsed.output;

  if (typeof leader === "string") {
    // Returns club name if leader
    return { isLeader: true, clubName: leader };
  }

  return { isLeader: leader === true, clubName: null };
}

/**
 * Get members of a club (for leaders to see their club's submissions)
 */
export async function getClubMembers(clubName: string) {
  const res = await fetch(
    `${CLUBS_API_URL}/members?club_name=${encodeURIComponent(clubName)}`,
    {
      headers: {
        Authorization: `Bearer ${env.CLUBS_API_KEY}`,
      },
    }
  );

  if (!res.ok) {
    throw new Error(`Failed to get club members: ${res.status}`);
  }

  const data = await res.json();
  return v.parse(ClubMembersSchema, data);
}
