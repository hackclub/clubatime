## Add HC CDN Client

Create `src/lib/server/hc-cdn.ts`:

```clubatime/src/lib/server/hc-cdn.ts#L1-55
import { env } from "$env/dynamic/private";
import * as v from "valibot";

const CDN_API_URL = "https://cdn.hackclub.com/api/v3/new";

const CdnFileSchema = v.object({
  deployedUrl: v.string(),
  file: v.string(),
  sha: v.string(),
  size: v.number(),
});

const CdnResponseSchema = v.object({
  files: v.array(CdnFileSchema),
  cdnBase: v.string(),
});

export type CdnFile = v.InferOutput<typeof CdnFileSchema>;

/**
 * Upload URLs to Hack Club CDN for permanent storage
 * @param urls - Array of URLs to mirror to CDN
 * @returns Array of permanent CDN URLs
 */
export async function uploadToCdn(urls: string[]): Promise<string[]> {
  if (urls.length === 0) return [];

  const res = await fetch(CDN_API_URL, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${env.HC_CDN_API_KEY}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify(urls),
  });

  if (!res.ok) {
    const error = await res.text();
    throw new Error(`HC CDN error ${res.status}: ${error}`);
  }

  const data = await res.json();
  const parsed = v.parse(CdnResponseSchema, data);

  return parsed.files.map((f) => f.deployedUrl);
}

/**
 * Upload a single URL to CDN
 */
export async function uploadSingleToCdn(url: string): Promise<string> {
  const [result] = await uploadToCdn([url]);
  if (!result) {
    throw new Error("Failed to upload to CDN");
  }
  return result;
}
```

