import { form, query, getRequestEvent } from "$app/server";
import { redirect, fail } from "@sveltejs/kit";
import * as v from "valibot";
import { auth } from "$lib/server/auth";
import { getActiveClubs, createSubmission } from "$lib/server/airtable";
import { getLeaderByEmail } from "$lib/server/clubs-api";
import { SubmissionSchema } from "$lib/schemas/submission";

/**
 * Get clubs list and user profile for form
 */
export const getFormData = query(async () => {
  const event = getRequestEvent();
  const session = await auth.api.getSession({
    headers: event.request.headers,
  });

  if (!session?.user) {
    return { user: null, clubs: [], leaderStatus: null };
  }

  const [clubs, leaderStatus] = await Promise.all([
    getActiveClubs(),
    getLeaderByEmail(session.user.email),
  ]);

  return {
    user: session.user,
    clubs,
    leaderStatus,
  };
});

/**
 * Submit project form
 */
export const submitProject = form(async (formData) => {
  const event = getRequestEvent();
  const session = await auth.api.getSession({
    headers: event.request.headers,
  });

  if (!session?.user) {
    redirect(303, "/");
  }

  // Parse form data
  const rawData = Object.fromEntries(formData);
  const result = v.safeParse(SubmissionSchema, rawData);

  if (!result.success) {
    // Return validation errors
    const errors: Record<string, string> = {};
    for (const issue of result.issues) {
      const path = issue.path?.[0]?.key;
      if (typeof path === "string") {
        errors[path] = issue.message;
      }
    }
    return fail(400, { errors, values: rawData });
  }

  // Get leader status for club role
  const leaderStatus = await getLeaderByEmail(session.user.email);
  const clubRole = leaderStatus.isLeader ? "Leader" : "Member";

  try {
    await createSubmission({
      ...result.output,
      clubRole,
      playableUrl: result.output.playableUrl || undefined,
      addressLine2: result.output.addressLine2 || undefined,
      projectFilesUrl: result.output.projectFilesUrl || undefined,
      howDidYouHear: result.output.howDidYouHear || undefined,
      doingWell: result.output.doingWell || undefined,
      howImprove: result.output.howImprove || undefined,
    });

    redirect(303, "/submit/success");
  } catch (error) {
    console.error("Submission failed:", error);
    return fail(500, { 
      errors: { form: "Failed to submit. Please try again." },
      values: rawData,
    });
  }
});
