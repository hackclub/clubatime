    }

    offset = parsed.offset;
  } while (offset);

  return clubs.sort((a, b) => a.name.localeCompare(b.name));
}

export type SubmissionData = {
  firstName: string;
  lastName: string;
  email: string;
  slackId: string;
  birthday: string;
  githubUsername: string;
  clubRole: string;
  clubId: string;
  hackatimeProject: string;
  projectType: string;
  description: string;
  codeUrl: string;
  playableUrl?: string;
  screenshotUrl: string;
  projectFilesUrl?: string;
  addressLine1: string;
  addressLine2?: string;
  city: string;
  region: string;
  postalCode: string;
  country: string;
  howDidYouHear?: string;
  doingWell?: string;
  howImprove?: string;
};

/**
 * Create a new submission in Airtable
 */
export async function createSubmission(data: SubmissionData) {
  const fields: Record<string, unknown> = {
    [SUBMISSION_FIELDS.firstName]: data.firstName,
    [SUBMISSION_FIELDS.lastName]: data.lastName,
    [SUBMISSION_FIELDS.email]: data.email,
    [SUBMISSION_FIELDS.slackId]: data.slackId,
    [SUBMISSION_FIELDS.birthday]: data.birthday,
    [SUBMISSION_FIELDS.githubUsername]: data.githubUsername,
    [SUBMISSION_FIELDS.clubRole]: data.clubRole,
    [SUBMISSION_FIELDS.club]: [data.clubId], // Link field expects array
    [SUBMISSION_FIELDS.hackatimeProject]: data.hackatimeProject,
    [SUBMISSION_FIELDS.projectType]: data.projectType,
    [SUBMISSION_FIELDS.description]: data.description,
    [SUBMISSION_FIELDS.codeUrl]: data.codeUrl,
    [SUBMISSION_FIELDS.addressLine1]: data.addressLine1,
    [SUBMISSION_FIELDS.city]: data.city,
    [SUBMISSION_FIELDS.region]: data.region,
    [SUBMISSION_FIELDS.postalCode]: data.postalCode,
    [SUBMISSION_FIELDS.country]: data.country,
    [SUBMISSION_FIELDS.status]: "Pending Review",
    // Attachments - Airtable will fetch from URL
    [SUBMISSION_FIELDS.screenshot]: [{ url: data.screenshotUrl }],
  };

  // Optional fields
  if (data.playableUrl) fields[SUBMISSION_FIELDS.playableUrl] = data.playableUrl;
  if (data.addressLine2) fields[SUBMISSION_FIELDS.addressLine2] = data.addressLine2;
  if (data.projectFilesUrl) {
    fields[SUBMISSION_FIELDS.projectFiles] = [{ url: data.projectFilesUrl }];
  }
  if (data.howDidYouHear) fields[SUBMISSION_FIELDS.howDidYouHear] = data.howDidYouHear;
  if (data.doingWell) fields[SUBMISSION_FIELDS.doingWell] = data.doingWell;
  if (data.howImprove) fields[SUBMISSION_FIELDS.howImprove] = data.howImprove;

  return airtableRequest(`/${TABLES.submissions}`, {
    method: "POST",
    body: JSON.stringify({ fields, typecast: true }),
  });
}
